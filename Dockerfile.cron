FROM node:22-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

COPY prisma ./prisma

RUN npx prisma generate

# Copy source code (shared + cron)
COPY src/shared ./src/shared
COPY src/cron ./src/cron
COPY tsconfig.json ./

# Build TypeScript
RUN npm run build

# Prune dev dependencies
RUN npm prune --production

CMD ["node", "dist/cron/index.js"]

