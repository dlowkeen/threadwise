generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
 
model Workspace {
  id              String   @id @default(uuid())
  slug            String   @unique
  slackTeamId     String   @unique @map("slack_team_id")
  slackTeamName   String   @map("slack_team_name")
  slackBotToken   String   @map("slack_bot_token")
  threadThreshold Int      @default(2) @map("thread_threshold")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  channels Channel[]
  jira     Jira?
  
  @@index([slug])
  @@index([slackTeamId])
  @@map("workspaces")
}

model Channel {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  slackChannelId String    @map("slack_channel_id")
  slackChannelName String   @map("slack_channel_name")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  @@unique([workspaceId, slackChannelId])
  @@index([workspaceId])
  @@index([slackChannelId])
  @@index([isActive])
  @@map("channels")
}

model Jira {
  id         String   @id @default(uuid())
  workspaceId String  @unique @map("workspace_id")
  baseUrl    String   @map("base_url")
  email      String
  apiToken   String   @map("api_token")
  projectKey String   @map("project_key")
  boardId    Int      @map("board_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  @@index([workspaceId])
  @@map("jira")
}